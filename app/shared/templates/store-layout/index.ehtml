import "./style.css";

<StoreLayout (isAdmin: boolean)>
  <div class="app store">
    <header class="store-header">
      <div class="page-shell row store-header-inner">
        <a class="store-brand row" href="/">
          <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M3 9l1.6-5h14.8L21 9" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
            <path d="M3 9h18v2.5a3 3 0 0 1-6 0 3 3 0 0 1-6 0 3 3 0 0 1-6 0z" fill="currentColor"/>
            <path d="M5 14v6h14v-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
          </svg>
          bytestall
        </a>

        <nav class="store-nav cluster is-md">
          <a class="link-muted" href="/">Shop</a>
          <a e:if={isAdmin} class="link-action" href="/admin">Dashboard</a>
        </nav>
      </div>
    </header>

    <main class="app-main">
      <slot/>
    </main>

    <footer class="store-footer">
      <div class="page-shell cluster store-footer-inner">
        <span>Templates and ebooks by Juno Park Studio.</span>
        <a class="link-muted" href="/signin">Creator sign in</a>
      </div>
    </footer>
  </div>
</StoreLayout>
