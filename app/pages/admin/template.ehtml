import "./style.css";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import type { Listener } from "@elements/app";
import { Alert } from "@elements/ui/alert";
import { Badge } from "@elements/ui/badge";
import { Button } from "@elements/ui/button";
import { Card, CardContent } from "@elements/ui/card";
import { Table, TableCell, TableHead } from "@elements/ui/table";
import { AdminLayout } from "#app/shared/templates/admin-layout";
import { formatPrice } from "#app/shared/services/catalog";
import { DOWNLOAD_LIMIT } from "#app/shared/services/downloads";
import { Dashboard, ProductStat, Sale, fetchDashboard, resendDownload } from "#app/shared/services/sales";

interface DashState {
  value: Dashboard;
  sentId: string;
  busyId: string;
  error: string;
}

export function money(cents: number): string {
  return (cents / 100).toLocaleString("en-US", { style: "currency", currency: "USD" });
}

export function maxDownloads(products: ProductStat[]): number {
  return Math.max(1, ...products.map((p) => p.downloads));
}

function when(d: Date): string {
  return d.toLocaleString("en-US", { month: "short", day: "numeric", hour: "numeric", minute: "2-digit" });
}

function onRefresh(state: DashState) {
  state.value = fetchDashboard();
}

function onResend(state: DashState, sale: Sale) {
  state.busyId = sale.id;
  state.error = "";

  try {
    state.value = resendDownload(sale.id);
    state.sentId = sale.id;
  } catch (err: any) {
    state.error = err.message;
  }

  state.busyId = "";
}

<html lang="en" class="page-admin" (
  initial: Dashboard,
  listener: Listener<{ event: "refresh" }>,
  private state: DashState = { value: initial, sentId: "", busyId: "", error: "" },
) oninit={() => listener.on("notify", () => onRefresh(state))}>
  <head>
    <title>Sales · bytestall</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <AdminLayout active="dashboard">
      <div class="stack is-xl">
        <div class="dash-head row">
          <h1>Sales</h1>
          <Badge variant="success" dot class="dash-live">Live</Badge>
        </div>

        <div class="dash-stats">
          <Card class="dash-stat is-hero">
            <CardContent class="stack is-sm">
              <span class="dash-stat-label">Total revenue</span>
              <span class="dash-stat-value">{money(state.value.revenueCents)}</span>
              <span class="dash-stat-sub">{money(state.value.revenueWeekCents)} in the last 7 days</span>
            </CardContent>
          </Card>

          <Card class="dash-stat">
            <CardContent class="stack is-sm">
              <span class="dash-stat-label">Sales</span>
              <span class="dash-stat-value">{state.value.salesCount.toLocaleString()}</span>
              <span class="dash-stat-sub">{state.value.salesWeek} in the last 7 days</span>
            </CardContent>
          </Card>

          <Card class="dash-stat">
            <CardContent class="stack is-sm">
              <span class="dash-stat-label">Average sale</span>
              <span class="dash-stat-value">{money(state.value.salesCount ? Math.round(state.value.revenueCents / state.value.salesCount) : 0)}</span>
              <span class="dash-stat-sub">per order</span>
            </CardContent>
          </Card>

          <Card class="dash-stat">
            <CardContent class="stack is-sm">
              <span class="dash-stat-label">Downloads</span>
              <span class="dash-stat-value">{state.value.downloads.toLocaleString()}</span>
              <span class="dash-stat-sub">files served</span>
            </CardContent>
          </Card>

          <Card class="dash-stat">
            <CardContent class="stack is-sm">
              <span class="dash-stat-label">Buyers</span>
              <span class="dash-stat-value">{state.value.buyers.toLocaleString()}</span>
              <span class="dash-stat-sub">unique emails</span>
            </CardContent>
          </Card>
        </div>

        <Alert e:if={state.error} variant="danger" description={state.error} />

        <div class="dash-cols">
          <Card title="By product" level={2}>
            <CardContent>
              <Table label="Sales by product">
                <table>
                  <thead>
                    <tr>
                      <TableHead>Product</TableHead>
                      <TableHead class="dash-bar-cell">Downloads per product</TableHead>
                      <TableHead align="end">Sales</TableHead>
                      <TableHead align="end">Revenue</TableHead>
                      <TableHead align="end">Downloads</TableHead>
                    </tr>
                  </thead>
                  <tbody>
                    <tr e:for={p of state.value.products}>
                      <TableCell wrap>{p.title}</TableCell>
                      <TableCell class="dash-bar-cell">
                        <span class="dash-bar" role="img" aria-label={`${p.downloads} downloads`}>
                          <span style={`width: ${(p.downloads / maxDownloads(state.value.products)) * 100}%`}></span>
                        </span>
                      </TableCell>
                      <TableCell align="end">{p.sales}</TableCell>
                      <TableCell align="end">{formatPrice(p.revenueCents)}</TableCell>
                      <TableCell align="end">{p.downloads}</TableCell>
                    </tr>
                  </tbody>
                </table>
              </Table>
            </CardContent>
          </Card>

          <Card title="Recent sales" level={2}>
            <CardContent>
              <Table label="Recent sales">
                <table class="dash-sales">
                  <thead>
                    <tr>
                      <TableHead>When</TableHead>
                      <TableHead>Buyer</TableHead>
                      <TableHead>Product</TableHead>
                      <TableHead align="end">Amount</TableHead>
                      <TableHead align="end">Link used</TableHead>
                      <TableHead></TableHead>
                    </tr>
                  </thead>
                  <tbody>
                    <tr e:for={sale of state.value.sales}>
                      <TableCell class="dash-when">{when(sale.paidAt)}</TableCell>
                      <TableCell class="dash-buyer truncate" attrs={{ title: sale.email }}>{sale.email}</TableCell>
                      <TableCell class="dash-product">{sale.productTitle}</TableCell>
                      <TableCell align="end" class="dash-amount">{formatPrice(sale.amountCents)}</TableCell>
                      <TableCell align="end" class="dash-used">{sale.downloadCount} / {DOWNLOAD_LIMIT}<span class="dash-used-label"> downloads</span></TableCell>
                      <TableCell align="end" class="dash-action">
                        <Badge e:if={state.sentId === sale.id} variant="success">Sent</Badge>
                        <Button e:else
                                size="sm"
                                loading={state.busyId === sale.id}
                                attrs={{ title: "Email a fresh link: 5 downloads, 30 days" }}
                                onclick={() => onResend(state, sale)}>
                          Resend email
                        </Button>
                      </TableCell>
                    </tr>
                  </tbody>
                </table>
              </Table>
            </CardContent>
          </Card>
        </div>
      </div>
    </AdminLayout>
  </body>
</html>
