import "./style.css";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Alert } from "@elements/ui/alert";
import { Button } from "@elements/ui/button";
import { Card, CardContent } from "@elements/ui/card";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";
import { Table, TableCell, TableHead } from "@elements/ui/table";
import { Textarea } from "@elements/ui/textarea";
import { AdminLayout } from "#app/shared/templates/admin-layout";
import { coverUrl, fileLabel, formatPrice, formatSize } from "#app/shared/services/catalog";
import { NewProduct, ProductRow, createProduct } from "./services";

interface ProductsState {
  rows: ProductRow[];
  form: NewProduct;
  errors: { [K in keyof NewProduct]?: string[] };
  formError: string;
  busy: boolean;
  added: string;
  uploads: number;
}

function blankForm(): NewProduct {
  return { title: "", description: "", price: "", cover: undefined, file: undefined };
}

function onCreate(state: ProductsState) {
  state.busy = true;
  state.errors = {};
  state.formError = "";
  state.added = "";

  try {
    let title = state.form.title.trim();
    state.rows = createProduct(state.form);
    state.form = blankForm();
    state.added = title;
    state.uploads++;
  } catch (err: any) {
    state.errors = err.errors ?? {};
    state.formError = err.errors ? "" : err.message;
  }

  state.busy = false;
}

<html lang="en" class="page-admin-products" (
  initial: ProductRow[],
  private state: ProductsState = { rows: initial, form: blankForm(), errors: {}, formError: "", busy: false, added: "", uploads: 0 },
)>
  <head>
    <title>Products · bytestall</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <AdminLayout active="products">
      <div class="stack is-xl">
        <h1>Products</h1>

        <div class="products-cols">
          <Card title="In the store" level={2}>
            <CardContent>
              <Table label="Products in the store">
                <table>
                  <thead>
                    <tr>
                      <TableHead></TableHead>
                      <TableHead>Product</TableHead>
                      <TableHead align="end">Price</TableHead>
                      <TableHead align="end">Sales</TableHead>
                    </tr>
                  </thead>
                  <tbody>
                    <tr e:for={p of state.rows}>
                      <TableCell><img class="products-thumb" src={coverUrl(p)} alt="" width="600" height="800"></TableCell>
                      <TableCell class="products-name">
                        <a class="link-action" href={`/products/${p.slug}`}>{p.title}</a>
                        <div class="products-file">{fileLabel(p.fileType)} · {formatSize(p.fileSize)}<span class="products-file-name"> · {p.fileName}</span></div>
                      </TableCell>
                      <TableCell align="end">{formatPrice(p.priceCents)}</TableCell>
                      <TableCell align="end">{p.sales}</TableCell>
                    </tr>
                  </tbody>
                </table>
              </Table>
            </CardContent>
          </Card>

          <Card title="Upload a product" level={2}>
            <CardContent>
              <form class="stack" onsubmit={() => onCreate(state)}>
                <Alert e:if={state.added} variant="success" role="status" title={`${state.added} is on sale`} />

                <Alert e:if={state.formError} variant="danger" description={state.formError} />

                <Field label="Title" errors={state.errors.title ?? []}>
                  <Input value={state.form.title} placeholder="e.g. Moodboard Kit" />
                </Field>

                <Field label="Description" errors={state.errors.description ?? []}>
                  <Textarea rows={4} value={state.form.description} />
                </Field>

                <Field label="Price in USD" errors={state.errors.price ?? []}>
                  <Input value={state.form.price} placeholder="e.g. 24" attrs={{ inputmode: "decimal" }} />
                </Field>

                <!-- Keyed on the upload count, so a finished upload re-renders the file inputs empty. -->
                <div e:for={batch of [{ id: `upload-${state.uploads}` }]} class="stack">
                  <div class="field">
                    <label for="cover">Cover image</label>
                    <input id="cover" type="file" accept="image/png,image/jpeg,image/webp,image/svg+xml" value={state.form.cover}>
                    <p e:if={state.errors.cover} class="error">{state.errors.cover!.join(" ")}</p>
                    <p e:else class="hint">PNG, JPEG, WebP or SVG, 3:4 looks best.</p>
                  </div>

                  <div class="field">
                    <label for="file">File</label>
                    <input id="file" type="file" accept=".pdf,.zip,application/pdf,application/zip" value={state.form.file}>
                    <p e:if={state.errors.file} class="error">{state.errors.file!.join(" ")}</p>
                    <p e:else class="hint">The PDF or ZIP the buyer downloads, up to 25 MB.</p>
                  </div>
                </div>

                <Button type="submit" variant="primary" loading={state.busy}>Put it on sale</Button>
              </form>
            </CardContent>
          </Card>
        </div>
      </div>
    </AdminLayout>
  </body>
</html>
