import "./style.css";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { redirect } from "@elements/app";
import { Alert, AlertDescription, AlertTitle } from "@elements/ui/alert";
import { Button } from "@elements/ui/button";
import { Card, CardContent } from "@elements/ui/card";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";
import { StoreLayout } from "#app/shared/templates/store-layout";
import { signin } from "#app/shared/services/auth";

// The seeded creator account (app/migrations/*-demo-store.migration.sql).
const DEMO_EMAIL = "creator@bytestall.dev";
const DEMO_PASSWORD = "bytestall";

interface SigninForm {
  email: string;
  password: string;
  error: string;
}

function onSubmit(form: SigninForm) {
  try {
    signin(form.email, form.password);
    form.error = "";
    redirect("/admin");
  } catch (err: any) {
    form.error = err.message;
  }
}

function useDemo(form: SigninForm) {
  form.email = DEMO_EMAIL;
  form.password = DEMO_PASSWORD;
}

<html lang="en" class="page-signin" (
  private form: SigninForm = { email: "", password: "", error: "" },
)>
  <head>
    <title>Creator sign in · bytestall</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <StoreLayout isAdmin={false}>
      <div class="page-shell is-form signin-shell">
        <div class="stack is-lg">
          <div class="stack is-sm">
            <p class="eyebrow">Creator</p>
            <h1>Sign in to your store</h1>
          </div>

          <Alert variant="info" role="none" class="signin-demo">
            <AlertTitle>Demo creator account</AlertTitle>
            <AlertDescription class="stack is-sm">
              <p>Email <code>{DEMO_EMAIL}</code> · password <code>{DEMO_PASSWORD}</code></p>
              <div>
                <Button size="sm" onclick={() => useDemo(form)}>Fill in the demo login</Button>
              </div>
            </AlertDescription>
          </Alert>

          <Card>
            <CardContent>
              <form class="stack" onsubmit={() => onSubmit(form)}>
                <Alert e:if={form.error} variant="danger" description={form.error} />

                <Field label="Email">
                  <Input type="email"
                         name="email"
                         value={form.email}
                         required
                         attrs={{ autocomplete: "email", autocapitalize: "none", spellcheck: "false" }} />
                </Field>

                <Field label="Password">
                  <Input type="password"
                         name="password"
                         value={form.password}
                         required
                         attrs={{ autocomplete: "current-password" }} />
                </Field>

                <Button type="submit" variant="primary" block>Sign in</Button>
              </form>
            </CardContent>
          </Card>
        </div>
      </div>
    </StoreLayout>
  </body>
</html>
